name: "Export GPG Key (Secure)"
description: "Export GPG Signing Key from GitHub Actions with security hardening"
author: "DCx7C5"

inputs:
  public:
    required: false
    default: 'true'
    description: "Exports GPG public key"
  private:
    required: false
    default: 'false'
    description: "Exports GPG private key"
  pass:
    required: false
    default: ''
    description: "Passphrase for encrypted GPG key (will be masked in logs)"
  export_sub:
    required: false
    default: 'true'
    description: "Exports only Subkey true/false"
  export_dir:
    required: false
    default: "${{ github.workspace }}/"
    description: "Directory path to exported GPG key"
  dcrypto:
    required: false
    default: 'false'
    description: "Uses dystopian-crypto management script"

runs:
  using: composite
  steps:
    - name: Mask sensitive inputs
      shell: bash
      run: |
        if [ -n "${{ inputs.pass }}" ]; then
          echo "::add-mask::${{ inputs.pass }}"
        fi

    - name: Validate GPG key exists
      shell: bash
      run: |
        set -euo pipefail

        # Check if any keys exist
        if ! gpg --list-keys > /dev/null 2>&1; then
          echo "ERROR: No GPG keys found" >&2
          exit 1
        fi

        # Count available keys
        KEY_COUNT=$(gpg --list-keys --with-colons 2>/dev/null | grep -c "^pub:" || true)
        if [ "$KEY_COUNT" -eq 0 ]; then
          echo "ERROR: No GPG public keys found" >&2
          exit 1
        fi

        echo "Found $KEY_COUNT GPG key(s)"

    - name: Export GPG key securely
      if: inputs.dcrypto == 'false'
      shell: bash
      run: |
        set -euo pipefail

        # Get key fingerprint with validation
        FPR=$(gpg --with-colons --with-subkey-fingerprints --list-keys | \
          grep -E "^fpr:.*:" | head -1 | cut -d: -f10)

        if [ -z "$FPR" ] || [ ${#FPR} -lt 40 ]; then
          echo "ERROR: Invalid or missing GPG fingerprint" >&2
          exit 1
        fi

        echo "Using GPG key: ${FPR:0:16}..."

        # Export public key if requested
        if [ "${{ inputs.public }}" = "true" ]; then
          export_file="${{ inputs.export_dir }}/public.asc"

          if ! gpg --armor --export "$FPR" > "$export_file" 2>/dev/null; then
            echo "ERROR: Failed to export public key" >&2
            rm -f "$export_file"
            exit 1
          fi

          echo "✓ Public key exported to: $export_file"
        fi

        # Export private key if requested (with passphrase protection)
        if [ "${{ inputs.private }}" = "true" ]; then
          if [ -z "${{ inputs.pass }}" ]; then
            echo "ERROR: Passphrase required for private key export" >&2
            exit 1
          fi

          export_file="${{ inputs.export_dir }}/private.asc"

          # Use temporary FD for passphrase to avoid shell history
          if ! exec 3<<< "${{ inputs.pass }}" && \
             gpg --armor --batch --pinentry-mode loopback \
                 --passphrase-fd 3 --export-secret-key "$FPR" > "$export_file" 2>/dev/null; then
            echo "ERROR: Failed to export private key" >&2
            rm -f "$export_file"
            exec 3>&-
            exit 1
          fi

          exec 3>&-

          # Secure the exported key file
          chmod 600 "$export_file"
          echo "✓ Private key exported to: $export_file (perms: 600)"
        fi

